{
  "name": "tiktok-growth-assistant",
  "productName": "TikTok Growth Assistant",
  "version": "0.2.0",
  "description": "Analytics, best-time-to-post and scheduled posting for your own TikTok account via the official TikTok API",
  "main": "src/main/main.js",
  "author": "Barrel Of Excellence",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.test.js && node test/growth.test.js",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.barrelofexcellence.tiktokgrowth",
    "productName": "TikTok Growth Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "TikTokGrowthAssistant-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TikTokGrowthAssistant-Portable-${version}.${ext}"
    },
    "publish": null
  }
}